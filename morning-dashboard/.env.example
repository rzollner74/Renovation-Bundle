# Copy this file to ".env" (same folder) and fill in your own values.
# The .env file stays on your Mac and is never committed (see .gitignore).

# ---- Server ----
PORT=3001

# ---- Gmail (📧 card) ----
# Use a Gmail App Password, NOT your normal password.
# Create one at: https://myaccount.google.com/apppasswords  (requires 2-Step Verification)
# Point this at your aggregate inbox — everything that lands there is counted.
IMAP_USER=youraddress@gmail.com
IMAP_PASSWORD=your-16-char-app-password
IMAP_HOST=imap.gmail.com
# Optional: pin specific labels for the unread breakdown (comma-separated,
# exact Gmail label names). Leave unset to auto-show labels with unread mail.
# GMAIL_LABELS=Bio-One,Card My Yard,Personal

# ---- Apollo (🚀 card) ----
# Apollo > Settings > Integrations > API  ->  create an API key.
APOLLO_API_KEY=your-apollo-api-key

# ---- Calendar (📅 card) ----
# Default: reads the Mac Calendar app (all accounts) via icalBuddy.
#   Install once:  brew install ical-buddy
#   Leave CALENDAR_ICS_URL unset to use this.
#
# Optional fallback: read secret iCal feed(s) instead of the Mac Calendar.
# One URL, or several separated by commas (no spaces). Keep these private.
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/.../basic.ics
